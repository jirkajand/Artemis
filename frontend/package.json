{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "generate:api": "npx openapi-merge-cli --config ../api/openapi-merge.config.json && npx openapi-generator-cli generate -i ../api/merged-openapi.yaml -g typescript-fetch -o src/lib/api",
    "prepare:smui": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.36.0",
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@smui-extra/autocomplete": "^8.0.3",
    "@smui-extra/badge": "^8.0.3",
    "@smui/banner": "^8.0.3",
    "@smui/button": "^8.0.3",
    "@smui/card": "^8.0.3",
    "@smui/checkbox": "^8.0.3",
    "@smui/chips": "^8.0.3",
    "@smui/circular-progress": "^8.0.3",
    "@smui/dialog": "^8.0.3",
    "@smui/drawer": "^8.0.3",
    "@smui/fab": "^8.0.3",
    "@smui/form-field": "^8.0.3",
    "@smui/icon-button": "^8.0.3",
    "@smui/layout-grid": "^8.0.3",
    "@smui/list": "^8.0.3",
    "@smui/menu": "^8.0.3",
    "@smui/menu-surface": "^8.0.3",
    "@smui/paper": "^8.0.3",
    "@smui/segmented-button": "^8.0.3",
    "@smui/select": "^8.0.3",
    "@smui/snackbar": "^8.0.3",
    "@smui/tab": "^8.0.3",
    "@smui/tab-bar": "^8.0.3",
    "@smui/textfield": "^8.0.3",
    "@smui/top-app-bar": "^8.0.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "openapi-merge-cli": "^1.3.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "smui-theme": "^8.0.3",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.4",
    "i18n-iso-countries": "^7.14.0",
    "keycloak-js": "^26.2.1"
  }
}
