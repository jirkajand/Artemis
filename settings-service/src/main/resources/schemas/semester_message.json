  "title": "SemesterMessage",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "semesterName": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "defaultRegistration": {
      "type": "boolean"
    }
  },
